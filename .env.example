# Cadena de conexión de Neon (usar la "pooled")
DATABASE_URL=
# Secreto para firmar sesiones del backoffice (mín. 32 caracteres): openssl rand -base64 48
AUTH_SECRET=
# URL pública del sitio (sin / final), p. ej. https://emauscristoreycali.com
NEXT_PUBLIC_SITE_URL=
# Token de Vercel Blob (se crea automáticamente al conectar un Blob Store en Vercel)
BLOB_READ_WRITE_TOKEN=
# Primer administrador (solo para npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
